cc_binary {
    name: "init_gsi",
    system_ext_specific: true,
    srcs: [
        "init_gsi.cpp",
        "quirks.cpp",
        
        // SoC-specific quirks
        "quirks/soc/mtk_ril.cpp",
    ],
    shared_libs: ["libbase", "libdl", "liblog", "libutils"],
    static_libs: ["libresetprop", "libc++fs"],
    init_rc: ["init_gsi.rc"],
    cflags: [
        "-std=gnu++17",
    ],
    target: {
        android: {
            ldflags: ["-Wl,--rpath,/system/${LIB}/bootstrap"],
        },
    },
    bootstrap: true,
}
