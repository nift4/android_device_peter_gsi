    init_rc: ["aguiauxcam.rc"],
    srcs: [
        "aguiauxcam.cpp",
    ],
    shared_libs: [
        "vendor.mediatek.hardware.agolddaemon-V1-ndk",
        "libbinder_ndk",
    ],
}
