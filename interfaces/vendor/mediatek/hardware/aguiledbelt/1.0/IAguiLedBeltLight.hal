interface IAguiLedBeltLight {
    setLedBeltLightMusicState(uint32_t lightId, uint32_t color, uint32_t brightness, bool isRandom);
    setLedBeltLightAtomphereState(uint32_t lightId, uint32_t color, uint32_t brightness);
